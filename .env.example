# PostgreSQL is optional. Only needed for durable operational state.
CROSSVENUE_POSTGRES_URL=postgres://crossvenue:crossvenue@localhost:5432/crossvenue?sslmode=disable

# API listen address
CROSSVENUE_API_LISTEN=127.0.0.1:8471

# Mode override: live-market-sim | replay | synthetic
CROSSVENUE_MODE=synthetic

# Live execution is NOT implemented. This flag must remain unset/false.
# Setting it to true causes the binary to refuse to start.
ENABLE_LIVE_EXECUTION=false
